{
  "name": "Temporal Wonder (Python 3.14)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "updateRemoteUserUID": false,
  "containerEnv": {
    "UV_VENV_CLEAR": "1",
    "SHELL": "/bin/bash"
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [7233, 8233, 10000],
  "portsAttributes": {
    "7233": {
      "label": "Temporal gRPC Server",
      "onAutoForward": "silent"
    },
    "8233": {
      "label": "Temporal Web UI",
      "onAutoForward": "notify"
    },
    "10000": {
      "label": "Azurite Blob Storage",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "google.google-antigravity",
        "mermaidchart.vscode-mermaid-chart"
      ]
    }
  },
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.gemini; UV_VENV_CLEAR=1 uv venv && uv pip install -e \".[dev]\"",
  "mounts": [
    "source=${localWorkspaceFolderBasename}-gemini-data,target=/home/vscode/.gemini,type=volume"
  ]
}
